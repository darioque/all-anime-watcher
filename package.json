{
    "name": "all-anime-watcher",
    "version": "0.1.25",
    "private": true,
    "description": "Follow anime and donghua across streaming sites: auto-track what you watch, get notified about new episodes, watch in one consistent player.",
    "type": "module",
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prepare": "husky",
        "build": "vite build && vite build --config vite.content.config.ts && node scripts/check-dist.mjs",
        "check": "node scripts/check-dist.mjs",
        "check:all": "npm run --silent check:schedule && npm run --silent check:matching && npm run --silent check:myanime && npm run --silent check:grouping && npm run --silent check:m3u8 && npm run --silent check:episodes && npm run --silent check:backup && npm run --silent check:downloads && npm run --silent check:categories && npm run --silent check:lab && npm run --silent check:extractors && npm run --silent check:pending && npm run --silent check:playback && npm run --silent check:inspect",
        "check:schedule": "esbuild scripts/check-schedule.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/schedule.mjs --log-level=warning && node .probe/schedule.mjs",
        "check:matching": "esbuild scripts/check-matching.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/matching.mjs --log-level=warning && node .probe/matching.mjs",
        "watch": "vite build --watch --mode development",
        "watch:content": "vite build --config vite.content.config.ts --watch --mode development",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,vue,css,html,json}\"",
        "probe": "esbuild scripts/probe-source.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/probe.mjs --log-level=warning && node .probe/probe.mjs",
        "check:myanime": "esbuild scripts/check-myanime.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/myanime.mjs --log-level=warning && node .probe/myanime.mjs",
        "check:grouping": "esbuild scripts/check-grouping.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/grouping.mjs --log-level=warning && node .probe/grouping.mjs",
        "check:extractors": "esbuild scripts/check-extractors.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/extractors.mjs --log-level=warning && node .probe/extractors.mjs",
        "check:lab": "esbuild scripts/check-lab.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/lab.mjs --log-level=warning && node .probe/lab.mjs",
        "check:categories": "esbuild scripts/check-categories.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/categories.mjs --log-level=warning && node .probe/categories.mjs",
        "check:backup": "esbuild scripts/check-backup.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/backup.mjs --log-level=warning && node .probe/backup.mjs",
        "check:downloads": "esbuild scripts/check-downloads.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/downloads.mjs --log-level=warning && node .probe/downloads.mjs",
        "check:episodes": "esbuild scripts/check-episodes.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/episodes.mjs --log-level=warning && node .probe/episodes.mjs",
        "check:m3u8": "esbuild scripts/check-m3u8.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/m3u8.mjs --log-level=warning && node .probe/m3u8.mjs",
        "check:pending": "esbuild scripts/check-pending.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/pending.mjs --log-level=warning && node .probe/pending.mjs",
        "check:playback": "esbuild scripts/check-playback.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/playback.mjs --log-level=warning && node .probe/playback.mjs",
        "check:inspect": "esbuild scripts/check-inspect.mts --bundle --platform=node --format=esm --alias:~=./src --outfile=.probe/inspect.mjs --log-level=warning && node .probe/inspect.mjs"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "hls.js": "^1.7.1",
        "idb": "^8.0.3",
        "pinia": "^4.0.3",
        "vue": "^3.5.41",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@types/chrome": "^0.1.28",
        "@types/node": "^24.13.3",
        "@types/webextension-polyfill": "^0.12.4",
        "@vitejs/plugin-vue": "^6.0.1",
        "esbuild": "^0.28.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.4.2",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    }
}
